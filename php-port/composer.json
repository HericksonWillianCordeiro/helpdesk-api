{
    "name": "herickson/helpdesk-api-php",
    "description": "HelpDesk API — port PHP com Symfony 7 + Doctrine ORM (equivalente ao projeto Python/FastAPI)",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "symfony/framework-bundle": "^7.1",
        "symfony/console": "^7.1",
        "symfony/dotenv": "^7.1",
        "symfony/flex": "^2",
        "symfony/runtime": "^7.1",
        "symfony/security-bundle": "^7.1",
        "symfony/validator": "^7.1",
        "symfony/serializer": "^7.1",
        "symfony/property-access": "^7.1",
        "doctrine/orm": "^3.2",
        "doctrine/doctrine-bundle": "^2.12",
        "doctrine/doctrine-migrations-bundle": "^3.3",
        "firebase/php-jwt": "^6.10"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "symfony/test-pack": "^1.1",
        "doctrine/doctrine-fixtures-bundle": "^3.6"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "php -l src/"
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "7.1.*"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    }
}
